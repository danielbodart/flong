# nspawn allow_list (systemd 260.2 src/nspawn/nspawn-seccomp.c), cap-gated rows
# resolved against flong's retained set: nspawn default caps (+NET_ADMIN with
# --private-network, -NET_ADMIN when steered; NET_ADMIN gates nothing here).
@aio
@basic-io
@chown
@default
@file-system
@io-event
@ipc
@keyring
@mount
@network-io
@process
@resources
@setuid
@signal
@sync
@timer
# @clock (CAP_SYS_TIME) @module (CAP_SYS_MODULE) @raw-io (CAP_SYS_RAWIO) @memlock (CAP_IPC_LOCK): caps NOT retained -> not allowed
arm_fadvise64_64
brk
cachestat
capget
capset
copy_file_range
fadvise64
fadvise64_64
flock
get_mempolicy
getcpu
getpriority
getrandom
ioctl
ioprio_get
kcmp
madvise
mincore
mprotect
mremap
name_to_handle_at
oldolduname
olduname
personality
readahead
readdir
remap_file_pages
sched_get_priority_max
sched_get_priority_min
sched_getaffinity
sched_getattr
sched_getparam
sched_getscheduler
sched_rr_get_interval
sched_rr_get_interval_time64
sched_yield
sendfile
sendfile64
setdomainname
setfsgid
setfsgid32
setfsuid
setfsuid32
sethostname
setpgid
setsid
splice
sysinfo
tee
umask
uname
userfaultfd
vmsplice
# cap-gated singles, retained caps: CAP_SYS_PTRACE, CAP_SYS_BOOT, CAP_SYS_TTY_CONFIG
process_vm_readv
process_vm_writev
ptrace
reboot
vhangup
# not retained: acct (CAP_SYS_PACCT), syslog (CAP_SYSLOG), bpf (CAP_BPF)
