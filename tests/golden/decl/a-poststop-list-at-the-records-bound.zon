    .command = .{"true"},
    .container = "box",
    .closure = "/nix/store/x-nixos-system-box",
    .cuid = 1000,
    .cgid = 100,
    .steps8 = "0123abcd",
    .name = "box",
    .payload = "/nix/store/x-payload/bin/flong-payload-box",
    .postStop = .{ .{"/nix/store/x-t/bin/t"}, .{""} },
    .postStopProgram = "/nix/store/x-hook/bin/flong-poststop-box",
}
