// The same, one byte longer: 4096 bytes, which record.create would refuse at launch.
.{
    .user = "u",
    .command = .{"true"},
    .container = "box",
    .closure = "/nix/store/x-nixos-system-box",
    .cuid = 1000,
    .cgid = 100,
    .steps8 = "0123abcd",
    .name = "box",
    .postStop = .{ .{"/nix/store/x-t/bin/t"}, .{""} },
    .postStopProgram = "/nix/store/x-hook/bin/flong-poststop-box",
}
