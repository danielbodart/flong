// What module.nix computes from a container's /etc/set-environment:
// references to the six the launch fills in, a $ spelt $$, and PATH,
// which replaces the launch's own.
.{
    .user = "u",
    .command = .{"true"},
    .container = "box",
    .closure = "/nix/store/x-nixos-system-box",
    .cuid = 1000,
    .cgid = 100,
    .steps8 = "0123abcd",
    .name = "box",
    .environment = .{
        .{ .name = "PATH", .value = "/run/wrappers/bin:${HOME}/.nix-profile/bin:/etc/profiles/per-user/${USER}/bin:/run/current-system/sw/bin" },
        .{ .name = "NIX_PROFILES", .value = "/run/current-system/sw ${HOME}/.nix-profile" },
        .{ .name = "EVERY", .value = "${HOME}${USER}${LOGNAME}${SHELL}${XDG_RUNTIME_DIR}${TMPDIR}" },
        .{ .name = "PRICE", .value = "$$5" },
        .{ .name = "SSH_ASKPASS", .value = "" },
    },
}
